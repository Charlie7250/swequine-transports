<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap-postgresql.php"
         colors="true"
>
    <testsuites>
        <testsuite name="PostgreSQL Integration">
            <directory>tests/Integration/Postgres</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="postgres" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_DATABASE" value="sweq_transports_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_USERNAME" value="sweq" force="true"/>
        <env name="DB_PASSWORD" value="sweq" force="true"/>
        <env name="POSTGRES_INTEGRATION_TEST" value="true" force="true"/>
        <env name="LARAVEL_STORAGE_PATH" value="/tmp/sweq-transports-postgres-tests" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_HOST" value="postgres" force="true"/>
        <server name="DB_PORT" value="5432" force="true"/>
        <server name="DB_DATABASE" value="sweq_transports_test" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <server name="DB_USERNAME" value="sweq" force="true"/>
        <server name="DB_PASSWORD" value="sweq" force="true"/>
        <server name="POSTGRES_INTEGRATION_TEST" value="true" force="true"/>
        <server name="LARAVEL_STORAGE_PATH" value="/tmp/sweq-transports-postgres-tests" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
